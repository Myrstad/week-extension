prefix: {
    enabled: bool,
    selected: string ["Week", "Semana", "Uke", <Custom>]
    custom: string
}

suffix: {
    enabled: bool,
    selected: string ["Week", "Semana", "Uke", <Custom>]
    custom: string
}

popup: {
    theme: string ["light" || "dark" || "auto"],
    accent: string ["grayscale", "accent"]
    accentColor: string [css/html color]
}

icon {
    selectedFont: string
    font: string
    fontSize: int
    selectedColor: string ["light", "dark", "auto", "accent", "custom"]
    customColor: string [css/html color]
    color: string
}